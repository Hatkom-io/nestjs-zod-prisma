datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = ".client"
}

generator zod {
  provider = "nestjs-zod-prisma"
  output   = "../actual/"
  imports  = "./zod-utils"
}

model Document {
  id       String  @id @default(cuid())
  filename String  @unique
  author   String
  contents String
  size     Decimal /// @z.preprocess((v) => v, imports.decimalSchema)

  created DateTime @default(now())
  updated DateTime @default(now())
}
